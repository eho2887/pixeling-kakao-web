{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"framework": null,
	"installCommand": "",
	"buildCommand": "",
	"outputDirectory": ".",
	"headers": [
		{
			"source": "/(.*)",
			"headers": [{ "key": "Access-Control-Allow-Origin", "value": "*" }]
		},
		{
			"source": "/app/media/(.*)",
			"headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
		}
	]
}
